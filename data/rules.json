    {
      "id": "E6",
      "name": "Nombres de relleno",
      "category": "Copy",
      "severity": "medium",
      "applies": "ambos",
      "weight": 2,
      "scope": "code",
      "pattern": "\\b(John Smith|Jane Doe|Sarah Johnson|John Doe|Usuario Demo|[A-Z\\u00c1\\u00c9\\u00cd\\u00d3\\u00da][a-z\\u00e1\\u00e9\\u00ed\\u00f3\\u00fa]+ (Cliente|Usuario|Demo|Test|Admin|Ejemplo))\\b",
      "flags": "",
      "threshold": 1,
      "why": "Es la forma en que un modelo evita inventar un nombre real.",
      "fix": "Datos de prueba con la textura del mercado objetivo.",
