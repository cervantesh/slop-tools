        "J_banda": 0.254,
        "pos": 0.941,
        "neg": 0.688,
        "separa": false,
        "decision": "J 0.25 pero los intervalos vuelven a solaparse con n mayor: dispara en el 94% de lo generado y el 69% de lo humano"
      },
      "tipo": "procedencia"
    },
    {
