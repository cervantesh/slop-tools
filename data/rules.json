{
  "_meta": {
    "version": "1.0.0",
    "descripcion": "Reglas declarativas de slop-tools. Las que son expresables como patron viven aqui; las que exigen ratios, distribuciones o resolucion de tokens estan en scripts/lib/checks.mjs y color.mjs.",
    "esquema": "id, name, category, severity, applies(landing|producto|ambos), weight(1-3), scope(style|code|all), pattern, flags, threshold, why, fix, exempt(generos exentos), source",
    "generos": [
      "editorial",
      "atmospheric",
      "modern-minimal",
      "playful"
    ],
    "validacion": {
      "informe": "research/RESULTADOS.md",
      "medido": {
        "pos": 50,
        "neg_stack": 62,
        "neg_classic": 11
      },
      "banda": {
        "rango": {
          "min": 20,
          "max": 200
        },
        "n_pos": 34,
        "n_neg": 32
      },
      "nota": "El campo validado de cada regla trae su fila de la tabla. Ausencia de validado = regla no presente en la medicion."
    },
    "tipos": {
      "procedencia": "Su proposito es detectar generacion. Forma la puntuacion.",
      "defecto": "Problema de calidad real, independiente de la autoria. Se reporta aparte y no puntua.",
      "promocion": "Una regla de calidad con J >= 0.20 o intervalos separados cuenta como procedencia: demostro llevar senal."
    }
  },
  "rules": [
    {
      "id": "A1",
      "name": "Gradiente morado-azul",
      "category": "Color",
      "severity": "high",
      "applies": "ambos",
      "weight": 2,
      "scope": "all",
      "pattern": "\\b(from|via|to)-(indigo|violet|purple|fuchsia)-\\d{3}\\b|#(6366f1|8b5cf6|818cf8|a855f7|7c3aed)\\b",
      "flags": "i",
      "threshold": 1,
      "why": "Es la eleccion estadisticamente segura: pasa contraste y no exige teoria del color. El tell mas citado de todas las fuentes.",
      "fix": "Elige un tono con intencion de marca. Si tu marca ES indigo, declara --brand-colors para exentarlo.",
      "source": "vibecodekit, anti-ai-slop, sikora",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
          "neg": 32
        },
        "J_banda": 0.103,
        "pos": 0.353,
        "neg": 0.25,
        "separa": false,
        "decision": "J 0.13 e intervalos solapados: el tell mas citado de la bibliografia rinde poco"
      },
      "tipo": "procedencia"
    },
    {
      "id": "A4",
      "name": "Resplandor de acento tras el hero",
      "category": "Color",
      "severity": "medium",
      "applies": "landing",
      "weight": 2,
      "scope": "all",
      "pattern": "radial-gradient\\(\\s*(circle|ellipse)|bg-\\[radial-gradient",
      "flags": "i",
      "threshold": 1,
      "exempt": [
        "atmospheric"
      ],
      "why": "Firma de v0/Cursor: orbe de acento difuminado detras del contenido.",
      "fix": "Si el fondo necesita profundidad, usa un escalon de luminancia en vez de un orbe.",
      "source": "vibecodekit",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
          "neg": 32
        },
        "J_banda": 0.143,
        "pos": 0.206,
        "neg": 0.063,
        "separa": false,
        "estado": "no_medible",
        "nota": "cero disparos en la banda; exige un hero con resplandor radial"
      },
      "sustrato": "CSS y clases de utilidad",
      "tipo": "procedencia"
    },
    {
      "id": "A5",
      "name": "Neon sobre oscuro con bordes que brillan",
      "category": "Color",
      "severity": "medium",
      "applies": "ambos",
      "weight": 2,
      "scope": "all",
      "pattern": "box-shadow:[^;]*0\\s+0\\s+\\d{2,}px[^;]*(#[0-9a-f]{6}|rgba)|shadow-\\[0_0_\\d{2,}px|\\bshadow-(indigo|violet|purple|cyan|fuchsia)-\\d{3}\\/\\d{2}",
      "flags": "i",
      "threshold": 3,
      "why": "Resplandor de color como sustituto de jerarquia.",
      "fix": "Comunica elevacion con luminancia y borde, no con halo.",
      "source": "vibecodekit",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
          "neg": 32
        },
        "J_banda": 0.088,
        "pos": 0.088,
        "neg": 0,
        "separa": false
      },
      "sustrato": "CSS y clases de utilidad",
      "tipo": "procedencia"
    },
    {
      "id": "B4",
      "name": "Etiquetas en mayusculas por todas partes",
      "category": "Tipografia",
      "severity": "low",
      "applies": "ambos",
      "weight": 1,
      "scope": "style",
      "pattern": "text-transform:\\s*uppercase",
      "flags": "i",
      "threshold": 6,
      "why": "El eyebrow en mayusculas repetido en cada seccion es tic de plantilla.",
      "fix": "Reserva las mayusculas para una funcion concreta, no para decorar cada bloque.",
      "source": "vibecodekit",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
          "neg": 32
        },
        "J_banda": -0.031,
        "pos": 0,
        "neg": 0.031,
        "separa": false
      },
      "tipo": "procedencia"
    },
    {
      "id": "C2",
      "name": "Franja lateral de color de 3-4px",
      "category": "Layout",
      "severity": "medium",
      "applies": "ambos",
      "weight": 2,
      "scope": "style",
      "pattern": "border-left:\\s*[34]px\\s+solid",
      "flags": "i",
      "threshold": 1,
      "why": "Adorno sin esfuerzo para estados semanticos.",
      "fix": "Usa fondo tintado o icono; el filete lateral no escala a mas de dos estados.",
      "source": "vibecodekit, sikora",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
          "neg": 32
        },
        "J_banda": 0.029,
        "pos": 0.029,
        "neg": 0,
        "separa": false
