      "tipo": "procedencia"
    },
    {
      "id": "D1",
      "name": "Enlaces a bancos de imagenes",
      "category": "Imagen",
      "severity": "critical",
      "applies": "ambos",
      "weight": 1,
      "scope": "all",
      "pattern": "(images\\.)?(unsplash|pexels|pixabay)\\.com",
      "flags": "i",
      "threshold": 1,
      "why": "Assets nunca curados. Si el diseno cuenta con la fotografia para aportar calidez, sin ella queda geometria vacia.",
      "fix": "Fotografia propia. Con seis fotos reales basta para empezar.",
      "source": "925studios, sikora",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
          "neg": 32
        },
        "J_banda": 0.02,
        "pos": 0.176,
        "neg": 0.156,
        "separa": false,
        "decision": "J 0.02 en banda: enlazar bancos de imagenes es igual de comun en ambas clases"
      },
      "tipo": "procedencia"
    },
    {
      "id": "D5",
      "name": "Emojis donde correspondia un icono",
      "category": "Imagen",
      "severity": "medium",
      "applies": "ambos",
      "weight": 3,
      "scope": "code",
      "pattern": "[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]",
      "flags": "u",
      "threshold": 5,
      "why": "El emoji es el camino mas corto de generar a publicar.",
      "fix": "Un set de iconos real, con trazo y rejilla consistentes.",
      "source": "sikora",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
          "neg": 32
        },
        "J_banda": 0.263,
        "pos": 0.294,
        "neg": 0.031,
        "separa": true,
        "decision": "J 0.26 en banda, intervalos separados. Precision alta y tasa negativa del 3%"
      },
      "tipo": "procedencia"
    },
    {
      "id": "E1",
      "name": "Abuso del em dash",
      "category": "Copy",
      "severity": "medium",
      "applies": "ambos",
      "weight": 2,
      "scope": "code",
      "pattern": "\\u2014",
      "flags": "",
      "threshold": 12,
      "why": "Puntuacion correcta, pero la densidad anomala delata prosa generada. El umbral es 12, no 1.",
      "fix": "Sustituye por punto o dos puntos donde la frase lo admita.",
      "source": "sikora, 925studios",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
