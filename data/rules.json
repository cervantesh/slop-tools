    {
      "id": "E7",
      "name": "Restos de andamiaje visibles al usuario",
      "category": "Copy",
      "severity": "critical",
      "applies": "producto",
      "weight": 2,
      "scope": "code",
      "pattern": "\\b(lorem ipsum|dummy|placeholder(?!\\s*=)|MVP|4242[\\s-]?4242|4111[\\s-]?1111|5555[\\s-]?5555|@example\\.com|\\.demo\\b)",
      "flags": "i",
      "threshold": 1,
      "why": "Senal inequivoca de que la salida nunca se reviso antes de ensenarla.",
      "fix": "Barrido de contenido antes de cualquier demo.",
      "source": "propia",
      "validado": {
        "corpus": "research/corpus.json",
        "n": {
          "pos": 34,
          "neg": 32
