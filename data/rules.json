      "severity": "medium",
      "applies": "ambos",
      "weight": 2,
      "scope": "code",
      "pattern": "\\b(seamless|innovador|innovative|leverage|potenciar|sinergia|synergy|end-to-end|revoluciona|delve into|all-in-one|todo en uno|de vanguardia|cutting-edge)\\b",
      "flags": "i",
      "threshold": 3,
      "why": "Vocabulario que no dice nada y funciona para cualquier empresa.",
